# Port HTTP API + WebSocket dashboard
PORT=4400
# Alamat bind; biarkan 127.0.0.1 kecuali tahu risikonya (endpoint tanpa autentikasi)
HOST=127.0.0.1
# Lokasi file SQLite
DB_PATH=./aethera.db
# Folder induk tempat workspace tiap agent dibuat
AGENT_WORKSPACES_DIR=./workspaces
# Path CLI Claude Code (harus sudah login Pro/Max; ANTHROPIC_API_KEY dihapus dari env agent)
CLAUDE_BIN=claude
# Model untuk semua agent (kosong = default akun), mis. sonnet / haiku
AETHERA_MODEL=
# Aturan izin tambahan dipisah koma (edit file sudah diizinkan lewat acceptEdits)
AETHERA_ALLOWED_TOOLS=Read,Glob,Grep,Bash(ls *),Bash(cat *)
# acceptEdits | auto | dontAsk | plan (bypassPermissions sengaja tidak didukung)
AETHERA_PERMISSION_MODE=acceptEdits
