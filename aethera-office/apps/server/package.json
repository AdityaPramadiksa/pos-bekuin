{
  "name": "@aethera/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "demo": "pnpm --filter @aethera/hook-relay build && tsx src/orchestrator/demo.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@aethera/hook-relay": "workspace:*",
    "@aethera/shared": "workspace:*"
  }
}
