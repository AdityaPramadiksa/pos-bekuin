# ── Server ──
PORT=3000
NODE_ENV=development
# Asal web yang boleh akses API (pisahkan dengan koma)
CORS_ORIGIN=http://localhost:5173
# URL publik web, dipakai untuk membuat link QR meja: <PUBLIC_WEB_URL>/m/<qrToken>
PUBLIC_WEB_URL=http://localhost:5173

# ── Database (sesuai docker-compose.yml) ──
DATABASE_URL=postgresql://bekuin:bekuin@localhost:5432/bekuin_pos?schema=public

# ── Auth ── (ganti dengan string acak panjang: openssl rand -hex 32)
JWT_ACCESS_SECRET=ganti-dengan-rahasia-access-minimal-32-karakter
JWT_REFRESH_SECRET=ganti-dengan-rahasia-refresh-minimal-32-karakter
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# ── Upload (foto menu, bukti bayar, nota belanja) ──
UPLOAD_DIR=./uploads

# ── Seeder: password awal akun admin & staff (wajib diganti saat login pertama) ──
SEED_ADMIN_PASSWORD=admin12345
SEED_STAFF_PASSWORD=staff12345

# Seeder membuat stok awal demo (60 pcs/produk + bahan & kemasan) bila belum ada mutasi stok.
# Isi false untuk data produksi sungguhan.
SEED_DEMO_STOCK=true

# IP asli klien di belakang proxy: loopback (dev/proxy Vite), 1 (Railway/Render/Nginx 1 lapis), false
TRUST_PROXY=loopback
