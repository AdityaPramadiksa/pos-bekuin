# Alamat API. Development: biarkan "/api/v1" (diteruskan oleh proxy Vite ke http://127.0.0.1:3000).
# Produksi (web dan API beda domain): isi URL lengkap, misal https://api.bekuin.id/api/v1
VITE_API_URL=/api/v1

# URL publik web untuk isi QR meja (produksi, HTTPS). Kosong = alamat yang sedang dibuka admin.
VITE_PUBLIC_WEB_URL=
