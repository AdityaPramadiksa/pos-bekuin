# Salin ke deploy/.env lalu isi. JANGAN commit deploy/.env.

# Domain yang sudah diarahkan (A record) ke IP VPS, tanpa https://
DOMAIN=pos.bekuin.id
# Email untuk sertifikat HTTPS Let's Encrypt
ACME_EMAIL=admin@bekuin.id

# Password database (acak panjang): openssl rand -hex 24
POSTGRES_PASSWORD=

# Rahasia JWT (berbeda satu sama lain): openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Web Push (opsional). Buat sekali: pnpm --filter @bekuin/api push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bekuin.id

# Password awal akun admin & staff saat seeder pertama (wajib diganti saat login pertama)
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# Backup harian: jam (WITA) & berapa hari disimpan
BACKUP_HOUR_WITA=2
BACKUP_KEEP_DAYS=14
